# Slack Webhook Configuration
# Get your webhook URL from: https://api.slack.com/messaging/webhooks
# Format: https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_WEBHOOK_URL=

# Slack Bot Token for Reaction Polling
# Get your bot token from: https://api.slack.com/apps
# Format: xoxb-your-bot-token-here
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=feedback

# Optional: Custom notification settings
# SLACK_CHANNEL=#general
# SLACK_USERNAME=Pounce Bot
